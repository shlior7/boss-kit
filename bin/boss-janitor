#!/usr/bin/env python3
"""boss-janitor: a safe, idempotent cleanup sweep that makes room on the machine, for this boss's project only.

  boss-janitor status                            memory numbers, and what a sweep would do now
  boss-janitor sweep [--apply] [--reason TEXT]   a dry run unless --apply AND config `janitor` is "apply"
  boss-janitor ledger [--apply] [--project P]    compact the project's ledger.md only (same dry-run gate)

What a sweep does, each rule keeping anything it is not sure of:
  orphans    processes of yours with ppid 1, <1% CPU (theirs and their children's), at least 30 min old, whose cwd is in
             the worktree of one of this boss's workers with an idle agent, and whose command is next, jest-worker,
             playwright, chromium, vitest, tsc, yarn, or node running jest-worker or next: SIGTERM, a short wait, then
             SIGKILL, by exact pid, children first
  dead tabs  bin/boss-close --dead for this boss's own workers (the ledger rows naming this boss)
  temp       /private/tmp/review-* git worktrees of this project's repo that no process holds, with nothing
             uncommitted or unpushed (git worktree remove); and the entries of claude-<uid> under /private/tmp and $TMPDIR older than 7 days
             that no process holds (removed by exact resolved path, never through a symlink)

  ledger     moves stale ledger.md content to <project>/ledger-archive/<YYYY-MM>.md, under the heading it had, and
             never deletes: dispatch rows older than 7 days with a final status (MERGED, ARCHIVED, CLOSED, DONE
             verified) whose workspace the host no longer lists; dated bullets, ### HH:MM wake, ## State and done
             ## REMINDER sections older than 7 days; tables and sections left empty. Title, Stack, Decisions and
             Reminders stay. Exact duplicate rows and bullets collapse; a cell or bullet over 500 chars is cut, its full
             line archived. Writes <ledger>.bak-<time> first, then a temp file and os.replace, and aborts if the
             ledger changed meanwhile.

Each action is one line in <data home>/<project>/janitor.log (pid or path, owner, age, reason); a sweep that changed
something adds one line to the project's ledger. A file `janitor.off` in the data home turns sweeps off.
"""
import functools
import glob
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import bosshost  # noqa: E402
import bosskit  # noqa: E402

BIN = os.path.dirname(os.path.abspath(__file__))
TOOLS = {"next", "next-server", "jest-worker", "playwright", "chromium", "vitest", "tsc", "yarn"}
MIN_AGE_S = 30 * 60
MAX_CPU = 1.0
TEMP_AGE_S = 7 * 86400
TMP = "/private/tmp"
TERM_WAIT_S = 5


def clean_env():
    """os.environ without the variables that point git at another repository than the path it is given."""
    return {k: v for k, v in os.environ.items() if k not in ("GIT_DIR", "GIT_WORK_TREE", "GIT_COMMON_DIR", "GIT_INDEX_FILE")}


def sh(argv, timeout=30):
    """stdout, or None when the command failed or is missing."""
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, env=clean_env())
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout if r.returncode == 0 else None


def memory():
    """The numbers bin/mem-gate --status reads: pressure level (1 normal, 2 warn, 4 critical), available %, swap %."""
    swap = re.findall(r"(total|used) = ([\d.]+)M", sh(["sysctl", "-n", "vm.swapusage"]) or "")
    s = {k: float(v) for k, v in swap}
    return {"level": (sh(["sysctl", "-n", "kern.memorystatus_vm_pressure_level"]) or "?").strip(),
            "free": (sh(["sysctl", "-n", "kern.memorystatus_level"]) or "?").strip(),
            "swap": int(s["used"] * 100 / s["total"]) if s.get("total") else 0,
            "swap_gb": round(s.get("used", 0) / 1024, 1)}


def etime_s(t):
    """ps etime ([[dd-]hh:]mm:ss) in seconds."""
    days, _, rest = t.rpartition("-")
    parts = [int(p) for p in rest.split(":")]
    while len(parts) < 3:
        parts.insert(0, 0)
    return int(days or 0) * 86400 + parts[0] * 3600 + parts[1] * 60 + parts[2]


def procs():
    """{pid: {pid, ppid, cpu, age, start, args}} of this user's processes; start = when it started (epoch s)."""
    out, now = {}, time.time()
    for line in (sh(["ps", "-xo", "pid=,ppid=,pcpu=,etime=,args="]) or "").splitlines():
        f = line.split(None, 4)
        if len(f) == 5:
            out[int(f[0])] = {"pid": int(f[0]), "ppid": int(f[1]), "cpu": float(f[2]), "age": etime_s(f[3]),
                              "start": now - etime_s(f[3]), "args": f[4]}
    return out


def same(pid, snap):
    """Whether pid is still the process the plan saw: same command, same start time (etime has 1 s steps)."""
    f = (sh(["ps", "-o", "etime=,args=", "-p", str(pid)]) or "").strip().split(None, 1)
    return len(f) == 2 and f[1] == snap["args"] and abs(time.time() - etime_s(f[0]) - snap["start"]) <= 2


def cwds(pids):
    """{pid: cwd} from lsof; a pid lsof cannot read is missing (its cwd is unknown)."""
    out, pid = {}, None
    for line in (sh(["lsof", "-a", "-d", "cwd", "-p", ",".join(map(str, pids)), "-Fpn"]) or "").splitlines() if pids else ():
        if line.startswith("p"):
            pid = int(line[1:])
        elif line.startswith("n") and pid:
            out[pid] = line[1:]
    return out


def open_paths():
    """Every path any process has open (cwds included), or None when lsof cannot say: then nothing counts as unheld."""
    raw = sh(["lsof", "-n", "-P", "-Fn"], timeout=120)
    return None if raw is None else {line[1:] for line in raw.splitlines() if line.startswith("n/")}


def tool(args):
    """Whether a command line is one of the dev tools a finished worker leaves behind."""
    name = os.path.basename(args.split()[0]) if args.split() else ""
    if name == "node":
        return "jest-worker" in args or "/next/" in args or "/.bin/next" in args
    return name in TOOLS


def under(path, root):
    return path == root or path.startswith(root.rstrip("/") + "/")


def age_txt(s):
    s = int(s)
    return f"{s // 86400}d{s % 86400 // 3600}h" if s >= 86400 else f"{s // 3600}h{s % 3600 // 60:02d}m"


# ---- whose: this boss's workers and their worktrees ------------------------------------------

@functools.lru_cache(maxsize=None)
def _deck():
    import importlib.util
    spec = importlib.util.spec_from_file_location("boss_deck_data", os.path.join(BIN, "boss-deck-data.py"))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def own_workers(ctx):
    """This boss's workers, as the host lists them: the ledger rows naming this boss (or no boss), never its own workspace.
    None when the host cannot be read (distinct from [], no workers): then an applied sweep touches nothing."""
    deck = _deck()
    tasks = deck.ledger_tasks(os.path.join(ctx.pdir, ctx.cfg.get("ledger", "ledger.md")))
    ids = [p for p, row in tasks.items() if deck.is_mine(row[4], ctx.bid) and not (ctx.workspace and p == ctx.workspace[:8])]
    if not ids:
        return []
    folder = bosskit.boss_folder(ctx.worktree)  # a domain boss acts only in its sidebar folder, as the deck shows it
    try:
        return [w for w in bosshost.get(ctx.cfg).workers(ids) or []
                if w.get("id", "")[:8] in ids and deck.in_folder(w.get("tags"), folder)]
    except (SystemExit, Exception) as e:  # an unreadable host: act on nothing
        print(f"boss-janitor: cannot list workers ({e}); an applied sweep touches nothing")
        return None


def roots(workers):
    """{resolved worktree: {id, name, idle}}; idle = no agent terminal is working or blocked."""
    out = {}
    for w in workers:
        if w.get("worktree"):
            states = [t["agent"].get("state") for t in w.get("terminals", []) if t.get("agent")]
            out[os.path.realpath(w["worktree"])] = {"id": w["id"][:8], "name": w.get("name", ""),
                                                     "idle": all(s == "idle" for s in states)}
    return out


# ---- rule 1: orphans -------------------------------------------------------------------------

def tree(table, pid):
    """pid and its descendants, children first."""
    out = []
    for c in sorted(p for p, r in table.items() if r["ppid"] == pid):
        out += tree(table, c)
    return out + [pid]


def orphans(table, cwd_of, own):
    """(act, keep): act = [{pid, pids (children first), owner, age, reason}], keep = [(pid, why)] for the tool orphans left alone."""
    act, keep = [], []
    for pid, p in sorted(table.items()):
        if p["ppid"] != 1 or not tool(p["args"]):
            continue
        name = os.path.basename(p["args"].split()[0])
        pids = tree(table, pid)
        # shortcut: ps %cpu is the kernel's decaying average (about a minute), not a sampled window; sample twice if it misfires
        busy = max(table[q]["cpu"] for q in pids)
        cwd = cwd_of.get(pid)
        root = next((r for r in own if cwd and under(os.path.realpath(cwd), r)), None)
        why = ("young" if p["age"] < MIN_AGE_S else f"busy ({busy:.1f}% CPU)" if busy >= MAX_CPU else "unknown cwd" if not cwd
               else f"not this boss's worktree ({cwd})" if not root else f"agent not idle ({own[root]['id']})" if not own[root]["idle"]
               else "")
        if why:
            keep.append((pid, f"{name}: {why}"))
        else:
            act.append({"pid": pid, "pids": pids, "owner": own[root]["id"], "age": p["age"],
                        "snap": {q: {"start": table[q].get("start", 0), "args": table[q]["args"]} for q in pids},
                        "reason": f"idle orphan {name} in {cwd}" + (f" (+{len(pids) - 1} children)" if len(pids) > 1 else "")})
    return act, keep


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def still_orphan(ctx, a):
    """Whether planned tree *a* still passes the orphan rule on fresh ps, lsof and host state (unreadable: no)."""
    act, _ = orphans(procs(), cwds([a["pid"]]), roots(own_workers(ctx) or []))
    return any(f["pid"] == a["pid"] for f in act)


def kill(pids, snap, wait=TERM_WAIT_S):
    """SIGTERM each exact pid (children first), wait, SIGKILL the ones still there. Never pkill or killall.
    Before each signal the pid must still match its snapshot (start time and command): a reused pid is skipped.
    Returns how many pids got SIGTERM."""
    pids = [p for p in pids if same(p, snap[p])]
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    end = time.time() + wait
    while time.time() < end and any(alive(p) for p in pids):
        time.sleep(0.2)
    for pid in pids:
        if alive(pid) and same(pid, snap[pid]):
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
    return len(pids)


# ---- rule 3: temp ----------------------------------------------------------------------------

def held(path, opened):
    return opened is None or any(under(o, path) for o in opened)


def newest_mtime(path, stop=None):
    """The newest mtime in a tree, never following a symlink; returns early at the first one newer than *stop*."""
    best = os.lstat(path).st_mtime
    for d, dirs, files in os.walk(path, followlinks=False):
        for n in dirs + files:
            try:
                best = max(best, os.lstat(os.path.join(d, n)).st_mtime)
            except OSError:
                pass
            if stop and best > stop:
                return best
    return best


def temp_roots():
    """The resolved claude-<uid> session roots under /private/tmp and $TMPDIR that exist."""
    found = [os.path.join(TMP, f"claude-{os.getuid()}")] + \
            ([os.path.join(os.environ["TMPDIR"], f"claude-{os.getuid()}")] if os.environ.get("TMPDIR") else [])
    return sorted({os.path.realpath(r) for r in found if os.path.isdir(r) and not os.path.islink(r)})


def common_dir(path):
    """The resolved git common dir of the repo *path* is in, or '' when git cannot say."""
    out = (sh(["git", "-C", path, "rev-parse", "--path-format=absolute", "--git-common-dir"]) or "").strip()
    return os.path.realpath(out) if out else ""


def recent(path, now=None):
    """Whether anything in *path* changed in the last 7 days (unreadable counts as recent)."""
    now = now or time.time()
    try:
        return now - newest_mtime(path, stop=now - TEMP_AGE_S) < TEMP_AGE_S
    except OSError:
        return True


def unpushed(wt):
    """The commits at HEAD that no remote branch has (one per line), or None when git cannot say."""
    return sh(["git", "-C", wt, "log", "--oneline", "HEAD", "--not", "--remotes"])


def temp(opened, repo, now=None):
    """(act, keep): act = [{path, kind (worktree | dir), root, age, reason}], keep = [(path, why)].
    *repo* is this project's git common dir: review worktrees of any other repo are not ours."""
    now = now or time.time()
    act, keep, young = [], [], 0
    for wt in sorted(glob.glob(os.path.join(TMP, "review-*"))):
        if os.path.islink(wt) or not os.path.isfile(os.path.join(wt, ".git")):
            continue  # not a git worktree: not ours to judge
        age = now - newest_mtime(wt, stop=now - TEMP_AGE_S)
        if age < TEMP_AGE_S:
            keep.append((wt, "younger than 7 days"))
            continue
        if not repo or common_dir(wt) != repo:
            keep.append((wt, "not this project's repo"))
            continue
        status = sh(["git", "--no-optional-locks", "-C", wt, "status", "--porcelain"])  # read-only: no index refresh
        ahead = unpushed(wt)
        why = ("held open" if held(wt, opened) else "git unreadable" if status is None or ahead is None
               else "uncommitted work" if status.strip() else "unpushed commits" if ahead.strip() else "")
        if why:
            keep.append((wt, why))
        else:
            act.append({"path": wt, "kind": "worktree", "root": TMP, "age": age, "reason": "review worktree untouched 7+ days, no process holds it"})
    for root in temp_roots():
        for name in sorted(os.listdir(root)):
            path = os.path.join(root, name)
            if os.path.islink(path):
                keep.append((path, "symlink"))
                continue
            if not os.path.isdir(path):
                continue  # session dirs only
            age = now - newest_mtime(path, stop=now - TEMP_AGE_S)
            if age < TEMP_AGE_S:
                young += 1
            elif held(path, opened):
                keep.append((path, "held open"))
            else:
                act.append({"path": path, "kind": "dir", "root": root, "age": age, "reason": "session dir untouched 7+ days"})
    return act, keep + ([(f"{young} session dir(s)", "younger than 7 days")] if young else [])


def remove(a, opened):
    """Remove one temp entry; returns an error line or ''. *opened* is a fresh open_paths(): the plan's age and
    open-file checks are redone here, since kills ran in between."""
    real = os.path.realpath(a["path"])
    if a["kind"] == "dir" and (os.path.islink(a["path"]) or os.path.dirname(real) != os.path.realpath(a["root"])):
        return "outside its root, kept"
    if held(a["path"], opened) or recent(a["path"]):
        return "in use or touched since the plan, kept"
    if a["kind"] == "worktree":
        common = common_dir(a["path"])
        if not common:
            return "git common dir unreadable"
        ahead = unpushed(a["path"])  # a commit since the plan moves HEAD without touching the worktree's files
        if ahead is None or ahead.strip():
            return "unpushed commits or git unreadable, kept"
        r = subprocess.run(["git", f"--git-dir={common}", "worktree", "remove", a["path"]], capture_output=True, text=True,
                           env=clean_env())
        return r.stderr.strip() if r.returncode else ""
    if os.path.isdir(real):
        shutil.rmtree(real)
    else:
        os.remove(real)
    return ""


# ---- rule 2: dead tabs -----------------------------------------------------------------------

def close_dead(ids, apply):
    """bin/boss-close --dead for these workers: its output lines."""
    if not ids:
        return []
    r = subprocess.run([sys.executable, os.path.join(BIN, "boss-close"), *([] if apply else ["--dry-run"]), "--dead", *ids],
                       capture_output=True, text=True)
    return [line for line in (r.stdout + r.stderr).splitlines() if line.strip()]


# ---- ledger: move stale content to ledger-archive/<YYYY-MM>.md, never delete -----------------

LEDGER_DAYS = 7
CELL_MAX = 500
FINAL = {"MERGED", "ARCHIVED", "CLOSED"}       # and DONE when its status cell says verified
KEPT = re.compile(r"## (Stack|Decisions|Reminders)\b")
LOGS = re.compile(r"## State\b|## REMINDER\b.*\bdone\b|### \d{1,2}:\d{2}\b.*\bwake\b", re.I)
DAY = re.compile(r"\d{4}-\d{2}-\d{2}")
BULLET = re.compile(r"- (\d{4}-\d{2}-\d{2})\b")
SEP = re.compile(r"\|[-:| ]+\|?\s*$")
CUT = " … (full: ledger-archive/{}.md)"
PIPE = re.compile(r"(?<!\\)\|")


def _row(line):
    """A dispatch row's cells as the pane reads them (a bullet can hold one too), or None for any other line."""
    c = _deck().cells(line) if "|" in line else []
    return c if len(c) >= 7 and DAY.fullmatch(c[1]) else None


def _final(status):
    word = (status.split() or [""])[0].rstrip(",:").upper()
    return word in FINAL or (word == "DONE" and "verified" in status.lower())


def _cut(line, month):
    """The line with each long cell (or a long bullet) cut to CELL_MAX, or the line itself. Never the date, workspace
    or proof cells, which the pane reads; never a cell already cut."""
    def short(s):
        return s if len(s) <= CELL_MAX or "(full: ledger-archive/" in s else s[:CELL_MAX].rstrip("\\") + CUT.format(month)
    if not _row(line):
        return short(line)
    segs = PIPE.split(line)
    return "|".join(s if i in (1, 3, 6) or s.strip() == short(s.strip()) else f" {short(s.strip())} " for i, s in enumerate(segs))


def compact(text, today, live):
    """Plan one compaction: (kept text, {month: archive text}, stats). *live* is called only when a final, old dispatch
    row needs it: the host's workspace-id prefixes, or None when the host cannot say (then every row stays)."""
    lines = text.split("\n")
    cutoff = time.strftime("%Y-%m-%d", time.localtime(time.mktime(time.strptime(today, "%Y-%m-%d")) - LEDGER_DAYS * 86400))
    old = lambda d: bool(d) and d < cutoff  # noqa: E731
    month = lambda s, dflt=today: ((DAY.search(s) or DAY.search(dflt)).group(0))[:7]  # noqa: E731
    h2, h3, kept = [None] * len(lines), [None] * len(lines), [False] * len(lines)
    cur2 = cur3 = None
    for i, l in enumerate(lines):
        if l.startswith("# "):
            cur2 = cur3 = None
        elif l.startswith("## "):
            cur2, cur3 = i, None
        elif l.startswith("### "):
            cur3 = i
        h2[i], h3[i] = cur2, cur3
        kept[i] = cur2 is None or bool(KEPT.match(lines[cur2]))
    heading = lambda i: lines[i].startswith("#")  # noqa: E731
    moved, drop, full, notes, sections, host_ok = {}, set(), {}, [], [], True
    # dated log sections, whole, heading included
    for k, l in enumerate(lines):
        if kept[k] or not LOGS.match(l):
            continue
        d = (DAY.search(l) or DAY.search(lines[h2[k]] if h2[k] is not None else "") or [""])[0] if l.startswith("###") \
            else (DAY.search(l) or [""])[0]
        if old(d):
            end = next((j for j in range(k + 1, len(lines)) if lines[j].startswith(("# ", "## ") if l.startswith("## ")
                                                                                 else ("# ", "## ", "### "))), len(lines))
            sections.append((k, end))
            moved.update({j: d[:7] for j in range(k, end) if not lines[j].startswith("|") and not _row(lines[j])})
    # exact duplicate rows and bullets collapse to the first copy
    seen = set()
    for i, l in enumerate(lines):
        if not kept[i] and (l.startswith("- ") or _row(l)):
            if l in seen:
                drop.add(i)
            seen.add(l)
    # final dispatch rows of a gone workspace, and dated bullets, older than LEDGER_DAYS
    cand, prefixes = [], set()
    for i, l in enumerate(lines):
        if kept[i] or i in moved or i in drop:
            continue
        c, b = _row(l), BULLET.match(l)
        if c and old(c[1]) and _final(c[5]):
            ws = re.match(r"(?:NEW\s+|ws\s+)?([0-9a-f]{8})", c[3], re.I)
            if ws:
                cand.append((i, ws.group(1).lower(), c[1][:7]))
        elif b and not c and old(b.group(1)):
            moved[i] = b.group(1)[:7]
    if cand:
        on_host = live()
        if on_host is None:
            host_ok = False
            notes.append(f"host unreadable: {len(cand)} final dispatch row(s) kept")
        for i, ws, m in cand if on_host is not None else ():
            if ws not in on_host:
                moved[i], prefixes = m, prefixes | {ws}
    gone = lambda i: i in moved or i in drop  # noqa: E731
    for k, end in sections:  # a log section keeps its heading while a row under it stays
        if any(not gone(j) and lines[j].strip() for j in range(k + 1, end)):
            moved.pop(k)
    # a dispatch table left with only its header and separator goes too, then a section left empty
    runs, run = [], []
    for i, l in enumerate(lines + [""]):
        if i < len(lines) and l.startswith("|") and not kept[i]:
            run.append(i)
        elif run:
            runs, run = runs + [run], []
    header = {}
    for r in runs:
        head = r[:2] if len(r) >= 2 and SEP.match(lines[r[1]]) and not _row(lines[r[0]]) else []
        header.update({i: head for i in r})
        rest = [i for i in r if i not in head]
        if head and rest and any(i in moved for i in rest) and all(gone(i) for i in rest):
            moved.update({i: next(moved[j] for j in rest if j in moved) for i in head})
    for k, l in enumerate(lines):
        if l.startswith("## ") and not kept[k] and k not in moved:
            body = [j for j in range(k + 1, len(lines)) if h2[j] == k]
            if any(j in moved for j in body) and all(gone(j) for j in body if lines[j].strip()):
                moved[k] = next(moved[j] for j in body if j in moved)
    # long cells in what stays
    out, gap = [], False
    for i, l in enumerate(lines):
        if gone(i):
            gap = True
            continue
        if l == "" and gap and out and out[-1] == "":
            continue
        gap = False
        if not kept[i] and not heading(i) and (l.startswith("- ") or _row(l)):
            c = _cut(l, month(l))
            if c != l:
                full[i] = month(l)
            l = c
        out.append(l)
    # the archive: each moved or cut line, under the headings and table header it had
    archive = {}
    for m in sorted(set(moved.values()) | set(full.values())):
        mine = {i for i, mm in list(moved.items()) + list(full.items()) if mm == m}
        ctx = {j for i in mine for j in (h2[i], h3[i], *header.get(i, [])) if j is not None}
        body = []
        for i in sorted(mine | ctx):
            for l in ([""] if heading(i) else []) + [lines[i]] + ([""] if heading(i) else []):
                if l or (body and body[-1]):
                    body.append(l)
        archive[m] = f"\n<!-- boss-janitor ledger: archived {time.strftime('%Y-%m-%d %H:%M')} -->\n" + "\n".join(body) + "\n"
    kept_text = "\n".join(out)
    return kept_text, archive, {"moved": len(moved), "dupes": len(drop), "cut": len(full), "prefixes": prefixes,
                                "notes": notes, "host_ok": host_ok, "items": [(i + 1, moved[i], lines[i]) for i in sorted(moved)],
                                "before": len(text.encode()), "after": len(kept_text.encode())}


def check(before, after, prefixes):
    """Raise unless the pane reads the same row (task, status, date, proof, boss) for every workspace whose rows stayed."""
    deck, rows = _deck(), []
    for text in (before, after):
        with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False) as f:
            f.write(text)
        rows.append(deck.ledger_tasks(f.name))
        os.remove(f.name)
    bad = [p for p, r in rows[0].items() if p not in prefixes and rows[1].get(p, ())[:5] != r[:5]]
    if bad:
        raise RuntimeError(f"the pane would read different rows for {', '.join(bad[:5])}")


class Changed(Exception):
    pass


def live_workspaces(cfg):
    """The host's workspace-id prefixes, or None when it cannot list them (an empty list is a host that failed)."""
    try:
        ws = bosshost.get(cfg).workers() or []
    except (SystemExit, Exception):
        return None
    return {w["id"][:8].lower() for w in ws if w.get("id")} or None


def kb(n):
    return f"{n / 1024:.0f} KB" if n >= 10240 else f"{n / 1024:.1f} KB"


def ledger(pdir, cfg, apply, today=None):
    """Compact one project's ledger (or, without apply, describe it): (summary line or '', item lines)."""
    path = os.path.join(pdir, cfg.get("ledger", "ledger.md"))
    try:
        st = os.stat(path)
        text = open(path).read()
    except OSError:
        return "", []
    kept, archive, s = compact(text, today or time.strftime("%Y-%m-%d"), lambda: live_workspaces(cfg))
    if kept == text:
        return "", s["notes"]
    if apply and not s["host_ok"]:
        raise RuntimeError("host unreadable: applied compaction stopped, nothing changed")
    check(text, kept, s["prefixes"])
    files = ", ".join(f"ledger-archive/{m}.md" for m in archive)
    summary = (f"{'' if apply else 'would '}compact ledger {path}: move {s['moved']} line(s), collapse {s['dupes']} duplicate(s), "
               f"cut {s['cut']} long cell(s){' -> ' + files if files else ''}; {kb(s['before'])} -> {kb(s['after'])}")
    items = s["notes"] + [f"move L{n} -> {m}: {l[:100]}" for n, m, l in s["items"]]
    if not apply:
        return summary, items
    adir = os.path.join(pdir, "ledger-archive")
    os.makedirs(adir, exist_ok=True)
    bak, tmp = f"{path}.bak-{time.strftime('%Y%m%d-%H%M%S')}", path + ".janitor-tmp"
    shutil.copy2(path, bak)
    with open(tmp, "w") as f:
        f.write(kept)
    shutil.copymode(path, tmp)
    sizes = {}
    try:
        for m, block in archive.items():
            a = os.path.join(adir, f"{m}.md")
            sizes[a] = os.path.getsize(a) if os.path.exists(a) else None
            with open(a, "a") as f:
                f.write(block)
        with bosskit.locked(path):  # boss-host create's row write takes it too: none lands between the check and the replace
            now = os.stat(path)
            if (now.st_mtime_ns, now.st_size) != (st.st_mtime_ns, st.st_size):
                raise Changed(f"{path} changed while compacting (another boss wrote it); nothing changed")
            os.replace(tmp, path)
    except BaseException:
        for a, size in sizes.items():  # undo the archive appends
            if size is None:
                os.remove(a)
            else:
                os.truncate(a, size)
        for p in (tmp, bak):
            if os.path.exists(p):
                os.remove(p)
        raise
    return summary + f" (backup {os.path.basename(bak)})", items


# ---- the sweep -------------------------------------------------------------------------------

def plan(ctx):
    found = own_workers(ctx)
    workers = found or []
    own = roots(workers)
    table = procs()
    cand = [pid for pid, p in table.items() if p["ppid"] == 1 and tool(p["args"])]
    o_act, o_keep = orphans(table, cwds(cand), own)
    t_act, t_keep = temp(open_paths(), common_dir(ctx.worktree))
    # Full workspace ids: hosts need them; the short id is only for log text.
    return {"workers": [w["id"] for w in workers], "orphans": o_act, "temp": t_act, "keep": o_keep + t_keep,
            "host_ok": found is not None}


def log(ctx, line, reason):
    with open(os.path.join(ctx.pdir, "janitor.log"), "a") as f:
        f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {line}" + (f" reason={reason}" if reason else "") + "\n")


def ledger_line(ctx, text):
    path = os.path.join(ctx.pdir, ctx.cfg.get("ledger", "ledger.md"))
    with bosskit.locked(path), open(path, "a") as f:
        last = bosskit._read(path).rstrip("\n").rsplit("\n", 1)[-1]
        f.write(("\n" if last.startswith("|") else "") + f"- {time.strftime('%Y-%m-%d %H:%M')} {text}\n")


def sweep(ctx, apply, reason="", p=None, record=True):
    """Run (or, without apply, describe) one sweep; returns its lines. record=False (status) writes no log line."""
    p = p or plan(ctx)
    if apply and not p.get("host_ok", True):
        return ["host unreadable: applied sweep stopped, nothing touched (no kills, no dead tabs, no temp removal)"]
    note = log if record else (lambda *a: None)
    verb = "" if apply else "would "
    out, done = [], 0
    for a in p["orphans"]:
        line = f"{verb}kill pid={a['pid']} owner={ctx.name}/{a['owner']} age={age_txt(a['age'])} {a['reason']} pids={','.join(map(str, a['pids']))}"
        if apply and not still_orphan(ctx, a):
            line = f"keep pid={a['pid']}: no longer an idle orphan of this boss's workers"
        elif apply and not kill(a["pids"], a["snap"]):
            line = f"skip pid={a['pid']}: exited or changed since the plan, nothing signalled"
        elif apply:
            done += 1
        out.append(line)
        note(ctx, line, reason)
    for line in close_dead(p["workers"], apply):
        out.append(f"dead tabs: {line}")
        if re.match(r"(closed|would close) [1-9]", line):
            done += int(apply)
            note(ctx, f"dead tabs owner={ctx.name}: {line}", reason)
    opened = open_paths() if apply and p["temp"] else None
    for a in p["temp"]:
        err = remove(a, opened) if apply else ""
        line = f"{verb}remove {a['kind']} {a['path']} owner={ctx.name} age={age_txt(a['age'])} {a['reason']}" + (f" FAILED: {err}" if err else "")
        done += int(apply and not err)
        out.append(line)
        note(ctx, line, reason)
    try:
        summary, _ = ledger(ctx.pdir, ctx.cfg, apply)
    except (Changed, RuntimeError) as e:
        summary = f"ledger kept: {e}"
    if summary:
        out.append(summary)
        note(ctx, summary, reason)
    out += [f"keep {k}: {why}" for k, why in p["keep"]]
    if done:
        ledger_line(ctx, f"janitor: {done} cleanup action(s) ({len(p['orphans'])} orphan trees, {len(p['temp'])} temp entries)"
                         + (f", reason {reason}" if reason else "") + "; see janitor.log")
    return out + [f"{'swept' if apply else 'dry run'}: {len(p['orphans'])} orphan tree(s), {len(p['temp'])} temp entr(ies)"
                  f", {len(p['keep'])} kept"]


def main(argv):
    if not argv or argv[0] not in ("status", "sweep", "ledger"):
        print(__doc__)
        return 0 if argv[:1] in (["-h"], ["--help"]) else 2
    off = os.path.exists(os.path.join(bosskit.home(), "janitor.off"))
    project = argv[argv.index("--project") + 1] if "--project" in argv[:-1] else None
    ctx = bosskit.load(name=project, make=False, resolve_host=False)
    if argv[0] == "status":
        m = memory()
        print(f"memory: pressure_level={m['level']} free={m['free']}% swap={m['swap']}% ({m['swap_gb']} GB)")
        print(f"janitor: {'off (janitor.off)' if off else ctx.cfg.get('janitor', 'dry-run')}; a sweep now would:")
        print("\n".join("  " + line for line in sweep(ctx, False, record=False)))
        return 0
    if off:
        print("off")
        return 0
    reason = argv[argv.index("--reason") + 1] if "--reason" in argv[:-1] else ""
    apply = "--apply" in argv and ctx.cfg.get("janitor") == "apply"
    if "--apply" in argv and not apply:
        print(f"boss-janitor: dry run: config janitor is {ctx.cfg.get('janitor')!r}; "
              "set it to \"apply\" (bosskit.py config set) to act")
    if argv[0] == "ledger":
        try:
            summary, items = ledger(ctx.pdir, ctx.cfg, apply)
        except (Changed, RuntimeError) as e:
            print(f"boss-janitor: ledger kept: {e}")
            return 1
        print("\n".join(items + [summary or f"ledger {ctx.name}: nothing to move"]))
        if summary and apply:
            log(ctx, summary, reason)
        return 0
    print("\n".join(sweep(ctx, apply, reason)))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
