#!/usr/bin/env python3
"""boss-migrate: move an old-layout kit's project data into $BOSS_HOME, leaving symlinks behind.

  boss-migrate [--kit DIR] [--boss ID] [--apply]

Finds, in the old kit (default: this kit):
  projects/<name>/      (v0.3-v0.4 layout)          -> $BOSS_HOME/<name>/
  state/<name>/         (v0.3-v0.4 runtime state)   -> $BOSS_HOME/<name>/bosses/<boss>/
  <name>/ with BOSS.md  (legacy: a folder at the kit root) -> $BOSS_HOME/<name>/
Each source is replaced by a symlink to its new place, so bosses still running on the old paths keep
working. Nothing that already exists in $BOSS_HOME is overwritten.
It also adds the host plugin's prompt import (@.../hosts/<host>/prompt.md) right after the template line of each
boss's CLAUDE.local.md that imports BOSS-template.md but no host prompt: the registered bosses' worktrees and this one.
Dry run unless --apply.
--boss names the boss that owned the old state (default: this session's host id, else "migrated").
"""
import argparse
import os
import shutil
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import bosskit  # noqa: E402

KIT_DIRS = {"bin", "mods", "projects", "state", "skills", ".git", ".claude-plugin", "tests"}


def plan(kit, home, boss):
    ops = []  # (source, destination)
    pdir = os.path.join(kit, "projects")
    for name in sorted(os.listdir(pdir)) if os.path.isdir(pdir) else []:
        src = os.path.join(pdir, name)
        if not name.startswith("_") and os.path.isdir(src) and not os.path.islink(src):
            ops.append((src, os.path.join(home, name)))
    for name in sorted(os.listdir(kit)):
        src = os.path.join(kit, name)
        if (name not in KIT_DIRS and not name.startswith(".") and os.path.isdir(src) and not os.path.islink(src)
                and os.path.isfile(os.path.join(src, "BOSS.md"))):
            ops.append((src, os.path.join(home, name)))
    sdir = os.path.join(kit, "state")
    for name in sorted(os.listdir(sdir)) if os.path.isdir(sdir) else []:
        src = os.path.join(sdir, name)
        if os.path.isdir(src) and not os.path.islink(src):
            ops.append((src, os.path.join(home, name, "bosses", boss)))
    return ops


def host_imports(home, cwd=None):
    """[(CLAUDE.local.md path, its text with the host prompt import)] for the boss worktrees that lack it."""
    wts = {}
    for bid, b in sorted(bosskit.registry(home).items()):
        if b.get("worktree") and b.get("project"):
            wts.setdefault(b["worktree"], (b["project"], bid, b.get("hostKind")))
    try:
        wts.setdefault(bosskit.worktree(cwd), (bosskit.project_name(cwd, home), None, None))
    except SystemExit:  # this worktree is no project's
        pass
    out = []
    for wt, (project, bid, kind) in sorted(wts.items()):
        path = os.path.join(wt, "CLAUDE.local.md")
        text = bosskit._read(path)
        try:
            cfg = bosskit.config_for(home, project, bid)
            host = cfg.get("host") or kind or bosskit.host_kind(cfg)
        except SystemExit as e:
            print(f"skip  {path}  (no host: {e})")
            continue
        new = bosskit.with_host_import(text, host)
        if new != text:
            out.append((path, new))
    return out


def main():
    ap = argparse.ArgumentParser(prog="boss-migrate")
    ap.add_argument("--kit", default=bosskit.KIT)
    ap.add_argument("--boss", default=bosskit.self_id() or "migrated")
    ap.add_argument("--apply", action="store_true")
    args = ap.parse_args()
    kit, home = os.path.abspath(args.kit), bosskit.home()
    ops, fixes = plan(kit, home, args.boss), host_imports(home)
    for path, text in fixes:
        print(f"{'add' if args.apply else 'would add'}  the host prompt import to {path}")
        if args.apply:
            with open(path, "w") as f:
                f.write(text)
    if not ops:
        print(f"boss-migrate: nothing to move in {kit}")
    for src, dst in ops:
        if os.path.exists(dst):
            print(f"skip  {src}  ({dst} already exists)")
            continue
        print(f"{'move' if args.apply else 'would move'}  {src}  ->  {dst}  (+ symlink back)")
        if args.apply:
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.move(src, dst)
            os.symlink(dst, src)
    if (ops or fixes) and not args.apply:
        print("dry run: nothing changed. Re-run with --apply.")


if __name__ == "__main__":
    main()
