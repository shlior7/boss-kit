#!/usr/bin/env python3
"""boss-close: close a worker's terminals the way its host's own close does (bin/boss-host close, close-dead).

  boss-close [--dry-run] <worker> <terminal> [<terminal> ...]   close these sessions
  boss-close [--dry-run] --dead <worker> [<worker> ...]         close the leftovers of ended sessions in these workers
  boss-close [--dry-run] --dead --all                           same, for every worker on the host

Only close sessions your ledger names as yours and that answered the status check (bin/boss-status-ask) as done.
A host with nothing to close says so (exit 3): archive the worker instead.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import bosshost  # noqa: E402
import bosskit  # noqa: E402


def main(argv):
    dry = "--dry-run" in argv
    argv = [a for a in argv if a != "--dry-run"]
    if not argv or argv[0] in ("-h", "--help") or (argv[0] != "--dead" and len(argv) < 2) or argv == ["--dead"]:
        print(__doc__)
        return 0 if argv[:1] in (["-h"], ["--help"]) else 2
    try:
        cfg = bosskit.load().cfg
    except (SystemExit, OSError, ValueError):  # no project here, or one whose config.json is missing or broken
        cfg = {}
    host = bosshost.get(cfg)
    try:
        if argv[0] == "--dead":
            print("\n".join(host.close_dead(None if argv[1:] == ["--all"] else argv[1:], dry)))
        else:
            print("\n".join(host.close(argv[0], argv[1:], dry)))
    except bosshost.Unsupported as e:
        print(f"boss-close: {e}")
        return 3
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
