#!/bin/bash
# boss-init <project> [--repo owner/repo] [--base main] [--me github-login] [--host PLUGIN] [--worktree DIR] [--answers FILE]
# boss-init --questions
# Scaffolds $BOSS_HOME/<project>/ (default ~/.claude/boss) from the kit's projects/_template:
# BOSS.md, config.json, ledger.md, lessons.md, prompts/. Seeds $BOSS_HOME/lessons.md (shared
# lessons) on first use. --worktree writes DIR/.boss so that worktree resolves to this project, and adds the host
# plugin's prompt import after the template line of DIR/CLAUDE.local.md when that file imports the template without it.
# It prints the CLAUDE.local.md that makes a worktree the boss (imports form, the host's prompt right after the template).
# --answers FILE takes the /boss onboarding form's answers (skills/boss/questions.json) as JSON, {"<id>": <answer>}, and
# applies them after scaffolding: config per layer and BOSS.md's ## Expectations. --questions prints the form.
# Project data is local: it lives outside the kit and is never pushed anywhere.
set -euo pipefail
KIT=${BOSS_KIT_HOME:-$(cd "$(dirname "$0")/.." && pwd)}
HOME_DIR=${BOSS_HOME:-$HOME/.claude/boss}
USAGE="usage: boss-init <project> [--repo owner/repo] [--base main] [--me login] [--host PLUGIN] [--worktree DIR] [--answers FILE] | boss-init --questions"
NAME=${1:?$USAGE}; shift
# A flag where the name goes ("boss-init --help") once scaffolded a project named after it.
case "$NAME" in -h|--help) echo "$USAGE"; exit 0;; --questions) exec python3 "$KIT/bin/bosskit.py" onboard questions --text;; esac
case "$NAME" in -*|_*|*/*|.*|bosses.json|lessons.md) echo "boss-init: bad project name: $NAME" >&2; echo "$USAGE" >&2; exit 2;; esac
DEST="$HOME_DIR/$NAME"
[ -e "$DEST" ] && { echo "boss-init: $DEST already exists" >&2; exit 1; }
REPO=""; BASE=""; ME=""; HOST=""; WT=""; ANSWERS=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) REPO=$2; shift 2;; --base) BASE=$2; shift 2;; --me) ME=$2; shift 2;; --host) HOST=$2; shift 2;; --worktree) WT=$2; shift 2;; --answers) ANSWERS=$2; shift 2;;
    *) echo "boss-init: unknown option $1" >&2; exit 2;;
  esac
done
[ -z "$ANSWERS" ] || [ -r "$ANSWERS" ] || { echo "boss-init: cannot read $ANSWERS" >&2; exit 2; }
[ -n "$ANSWERS" ] && [ -z "$HOST" ] && HOST=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("host") or "")' "$ANSWERS")
mkdir -p "$HOME_DIR"
cp -R "$KIT/projects/_template" "$DEST"
rm -f "$DEST/prompts/.gitkeep"
for f in BOSS.md ledger.md lessons.md; do sed -i.bak "s/{{PROJECT}}/$NAME/g" "$DEST/$f" && rm "$DEST/$f.bak"; done
[ -e "$HOME_DIR/lessons.md" ] || cp "$KIT/shared-lessons.example.md" "$HOME_DIR/lessons.md"
python3 - "$DEST/config.json" "$REPO" "$BASE" "$ME" "$HOST" <<'PY'
import json, sys
p, repo, base, me, host = sys.argv[1:]
c = json.load(open(p))
c.update({k: v for k, v in (("repo", repo), ("base_branch", base), ("me", me), ("host", host)) if v})
json.dump(c, open(p, "w"), indent=2); open(p, "a").write("\n")
PY
[ -n "$WT" ] && printf 'project: %s\n' "$NAME" > "$WT/.boss"
if [ -n "$ANSWERS" ]; then  # the form's answers, into the layers it names and BOSS.md
  (cd "${WT:-.}" && python3 "$KIT/bin/bosskit.py" onboard apply "$(cd "$(dirname "$ANSWERS")" && pwd)/$(basename "$ANSWERS")" --project "$NAME" --apply) >/dev/null
fi
LOCAL_MD=$(python3 - "$KIT" "$HOME_DIR" "$NAME" "$HOST" "$WT" <<'PY'
import os, sys
kit, h, name, host, wt = sys.argv[1:]
sys.path.insert(0, os.path.join(kit, "bin"))
import bosshost, bosskit
host = host or bosshost.kind({})
path = os.path.join(wt, "CLAUDE.local.md") if wt else ""
text = bosskit._read(path) if path else ""
if text and bosskit.with_host_import(text, host) != text:
    open(path, "w").write(bosskit.with_host_import(text, host))
    print(f"(added the {host} host prompt import to {path})", file=sys.stderr)
print(bosskit.boss_local_md(h, kit, name, host, "<its id: bin/boss-host self>"))
PY
)
cat <<MSG
Created $DEST
Next:
  1. Fill in $DEST/BOSS.md and $DEST/config.json (repo, base_branch, me, host, tracker);
     \`bosskit.py config show\` prints the resolved config and where each value comes from.
  2. In the worktree that will be the boss, add a gitignored CLAUDE.local.md (or run the /boss skill there instead of
     the imports; see README: Make a worktree the boss):

$(printf '%s\n' "$LOCAL_MD" | sed '/./s/^/     /')

  3. Project resolution: \$BOSS_PROJECT, then the worktree's .boss file, then its git remote vs config.repo.
MSG
[ -n "$ANSWERS" ] && python3 -c 'import json,sys; print("\n" + json.load(open(sys.argv[1]))["closing"])' "$KIT/skills/boss/questions.json"
exit 0
