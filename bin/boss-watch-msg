#!/usr/bin/env python3
"""boss-watch-msg <session> [<branch>]   the coderplex watcher (run with run_in_background; never edit while one runs)

On coderplex a worker finishes by sending its envelope to the boss (`coderplex-ctl sessions send <boss> --file -`), which
arrives as a new prompt in the boss's pane once its turn ends: the push wakes the boss, no screen is read. This watcher
is the safety net and the stage log. Every 20 s, for up to 3 h, it exits (which also wakes the boss) when:
  - a NEW message from <session> to this boss holds an envelope: a line starting BOSS_WORKER_DONE or BOSS_WORKER_BLOCKED
    (or the older SUPERSET_ token) directly followed by `task: <id>`; templates with <placeholder> fields are skipped.
    New means sent after the dispatch (this boss's last `sent` event for the session), so an envelope that lands before
    the watcher is armed still fires; with no `sent` event, every message already there is old;
  - with <branch>, about every 3rd poll, a PR on it gets a DONE-envelope comment, leaves draft or merges (PR READY #n),
    the same rule as boss-watch-done.sh's `pick` (run from the repo, or set GH_REPO);
  - the session's agent waits on someone (agent state blocked: a permission prompt or a question);
  - the agent sits idle for 9 polls (3 min) without an envelope;
  - the session is gone.
On a fire it logs the stage to this boss's events.jsonl (DONE, BLOCKED, PR READY or merged), for the boss-deck stages.
`boss-watch-msg --sig < text` prints the envelope it would fire on (`DONE|<id>|<summary start>`), nothing if none.
Env: BOSS_WATCH_POLL_S (20), BOSS_WATCH_POLLS (540). Needs coderplex-ctl, and gh for <branch>.
"""
import os
import re
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import bosshost  # noqa: E402
import bosskit  # noqa: E402

ENVELOPE = re.compile(r"(?:^|\n)[ \t>`⏺]*" + bosskit.ENVELOPE + r"\s+task:[ \t]*([A-Za-z0-9._-]+)")
PLACEHOLDER = re.compile(r"(task|summary|files|checks|proof|handoff|reason|needs):? *(<[a-z]|\.\.\.)")
DONE_COMMENT = re.compile(r"(^|\n)[ \t>`]*(?:BOSS|SUPERSET)_WORKER_DONE[ \t]+task:[ \t]*[A-Za-z0-9._-]")
IDLE_POLLS = 9


def sig(text):
    """'DONE|<task>|<first 30 chars of summary>' for the last real envelope in *text*, else ''."""
    for m in reversed(list(ENVELOPE.finditer(text or ""))):
        block = "\n".join(text[m.start():].strip("\n").splitlines()[:7])
        if PLACEHOLDER.search(block):
            continue
        su = re.search(r"summary:? +(.{0,30})", re.sub(r"\s+", " ", block))
        return f"{m.group(1)}|{m.group(2)}|" + (su.group(1).strip() if su else "")
    return ""


def ready(prs):
    """PR numbers that count as done: merged, open non-draft, or carrying a comment that starts a DONE envelope."""
    return {p["number"] for p in prs if p.get("state") == "MERGED" or (p.get("state") == "OPEN" and (
        not p.get("isDraft") or any(DONE_COMMENT.search(c.get("body") or "") for c in p.get("comments") or [])))}


def body(m):
    """A message's text: inline, or the file coderplex keeps it in."""
    b = m.get("body") or {}
    if isinstance(b, str):
        return b
    return b.get("text") or bosskit._read(b.get("file") or "")


def inbound(boss, session):
    """[(messageId, text, sent at in seconds)] of messages from *session* to *boss*, oldest first."""
    d = bosshost._json(bosshost.run(["coderplex-ctl", "sessions", "messages", boss, "--json"]), {})
    msgs = d.get("messages", []) if isinstance(d, dict) else []
    return [(m.get("messageId"), body(m), (m.get("createdAt") or 0) / 1000) for m in msgs
            if (m.get("from") or {}).get("session", "").startswith(session[:8]) and (m.get("to") or {}).get("session") == boss]


def pr_list(branch):
    out = bosshost.run(["gh", "pr", "list", "--head", branch, "--state", "all", "--json", "number,isDraft,state,comments"])
    return bosshost._json(out, None) if out else None


def watch(ctx, host, session, branch="", poll_s=20, polls=540, out=print):
    boss = host.self_id()
    ev = lambda stage, note: bosskit.add_event(ctx, session, stage, note)
    sent = max((e["at"] for e in bosskit.events(ctx.bdir) if e["ws"][:8] == session[:8] and e["stage"].lower() == "sent"), default=0)
    seen = {i for i, _, at in inbound(boss, session) if not sent or at < sent}
    prs = pr_list(branch) if branch else None
    pr_base = ready(prs) if prs is not None else None
    idle = 0
    for i in range(1, polls + 1):
        time.sleep(poll_s)
        for mid, text, _ in inbound(boss, session):
            if mid in seen:
                continue
            seen.add(mid)
            s = sig(text)
            if s:
                kind, task, summary = s.split("|", 2)
                ev(kind, f"{task}: {summary}")
                out(f"ENVELOPE {s}")
                out("\n".join(text.splitlines()[:60]))
                return 0
        if branch and i % 3 == 0:
            prs = pr_list(branch)
            if prs is not None:
                now = ready(prs)
                if pr_base is None:
                    pr_base = now  # the first successful read is the baseline
                elif now - pr_base:
                    n = min(now - pr_base)
                    merged = any(p["number"] == n and p.get("state") == "MERGED" for p in prs)
                    ev("merged" if merged else "PR READY", f"PR #{n}")
                    out(f"PR READY #{n}")
                    return 0
        w = host.worker(session)
        if not w:
            out("SESSION GONE (archived or deleted)")
            return 0
        state = next((t["agent"].get("state") for t in w.get("terminals", []) if t.get("agent")), "idle")
        if state == "blocked":
            ev("BLOCKED", "waiting on input")
            out("AGENT BLOCKED ON INPUT (a permission prompt or a question: open the session)")
            return 0
        idle = idle + 1 if state == "idle" else 0
        if idle >= IDLE_POLLS:
            out("AGENT IDLE WITHOUT ENVELOPE (check `coderplex-ctl sessions messages` and the PR)")
            return 0
    out("TIMEOUT")
    return 0


def main(argv):
    if argv[:1] == ["--sig"]:
        print(sig(sys.stdin.read()))
        return 0
    if not argv or argv[0].startswith("-") or len(argv) > 2:
        sys.exit(__doc__)
    ctx = bosskit.load()
    host = bosshost.get(ctx.cfg, "coderplex")
    if not host.self_id():
        sys.exit("boss-watch-msg: $CODERPLEX_SESSION_ID is not set: run it from the boss's coderplex session")
    return watch(ctx, host, argv[0], argv[1] if len(argv) > 1 else "",
                 float(os.environ.get("BOSS_WATCH_POLL_S", 20)), int(os.environ.get("BOSS_WATCH_POLLS", 540)))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
