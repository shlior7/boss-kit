#!/usr/bin/env python3
"""boss-next-hook: the boss plugin's Stop hook. The "Your move" line of a boss's reply must stand alone (template section 9).

Reads the hook input JSON on stdin. Only in a boss session (the worktree's boss marker binds this session) it finds the last
"Your move:" line of the final assistant message (last_assistant_message, else the transcript since the last user prompt),
runs bosskit.lint_next on it, and on shorthand blocks the stop with the reason so the boss rewrites the line. No
"Your move" line, not a boss, or anything unreadable: it allows, silently.
"""
import json
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import bosskit  # noqa: E402

YOUR_MOVE = re.compile(r"your move\W*:\W*(.*)", re.I)


def is_boss(cwd):
    bound = bosskit.boss_marker(bosskit.worktree(cwd))
    return bound is not None and (bound == "" or bound == bosskit.self_id())


def last_reply(inp):
    """The final assistant message's text: the hook's own field, else the assistant text after the last user prompt."""
    if inp.get("last_assistant_message"):
        return inp["last_assistant_message"]
    texts = []
    with open(inp["transcript_path"], encoding="utf-8") as f:
        for raw in f:
            try:
                e = json.loads(raw)
            except ValueError:
                continue
            content = (e.get("message") or {}).get("content")
            if e.get("type") == "user":
                # a tool result is a user entry too; only a prompt starts a new reply
                if isinstance(content, str) or any(c.get("type") == "text" for c in content or [] if isinstance(c, dict)):
                    texts = []
            elif e.get("type") == "assistant" and isinstance(content, list):
                texts += [c.get("text", "") for c in content if isinstance(c, dict) and c.get("type") == "text"]
    return "\n".join(texts)


def verdict(inp):
    """The block reason, or "" to allow."""
    if inp.get("stop_hook_active"):  # already rewriting once after a block: never loop
        return ""
    if not is_boss(inp.get("cwd") or os.getcwd()):
        return ""
    moves = [m.group(1).strip(" *_`") for m in YOUR_MOVE.finditer(last_reply(inp))]
    if not moves:
        return ""
    why = bosskit.lint_next(moves[-1])
    if not why:
        return ""
    return (f'The "Your move" line is shorthand ({why}): "{moves[-1]}". Rewrite it as one sentence that stands alone: '
            "what is being decided, the options, your recommendation, and what happens on each answer (template section 9).")


def main():
    try:
        why = verdict(json.load(sys.stdin))
    except Exception:  # a hook that crashes must never trap the session
        return
    if why:
        print(json.dumps({"decision": "block", "reason": why}))


if __name__ == "__main__":
    main()
