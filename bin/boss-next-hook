#!/usr/bin/env python3
"""boss-next-hook: the boss plugin's Stop hook. The "Your move" line of a boss's reply must stand alone (template section 9).

Reads the hook input JSON on stdin. Only in a boss session (the worktree's boss marker binds this session) it finds the last
"Your move:" line of the final assistant message (last_assistant_message, else the transcript's last assistant message),
runs bosskit.lint_next on it, and on shorthand blocks the stop with the reason so the boss rewrites the line; a rewrite is
checked again, up to MAX_BLOCKS blocks in a row per session. No "Your move" line, not a boss, or anything unreadable: it
allows, silently.

It also refuses once to end the turn while this boss has unread mail (inbox file without read_at) it has not raised yet: the
reason names the count, kinds and senders only, and the ids are recorded in cache/mail-raised.json so a mail is raised at
most once; never again in the same stop (stop_hook_active).
"""
import json
import os
import re
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import bosskit  # noqa: E402

MAX_BLOCKS = 3
YOUR_MOVE = re.compile(r"your move\W*:\W*(.*)", re.I)


def is_boss(cwd):
    bound = bosskit.boss_marker(bosskit.worktree(cwd))
    return bound is not None and (bound == "" or bound == bosskit.self_id())


def last_reply(inp):
    """The final assistant message's text: the hook's own field, else the assistant text after the last user prompt."""
    if inp.get("last_assistant_message"):
        return inp["last_assistant_message"]
    texts, msg_id = [], None
    with open(inp["transcript_path"], encoding="utf-8") as f:
        for raw in f:
            try:
                e = json.loads(raw)
            except ValueError:
                continue
            msg = e.get("message") or {}
            content = msg.get("content")
            if e.get("type") == "user":
                # a tool result is a user entry too; only a prompt starts a new reply
                if isinstance(content, str) or any(c.get("type") == "text" for c in content or [] if isinstance(c, dict)):
                    texts, msg_id = [], None
            elif e.get("type") == "assistant" and isinstance(content, list):
                # one message is written as several entries sharing its id; a new id (or none) starts the final message over
                if msg.get("id") is None or msg.get("id") != msg_id:
                    texts, msg_id = [], msg.get("id")
                texts += [c.get("text", "") for c in content if isinstance(c, dict) and c.get("type") == "text"]
    return "\n".join(texts)


def verdict(inp):
    """The block reason, or "" to allow."""
    if not is_boss(inp.get("cwd") or os.getcwd()):
        return ""
    moves = [m.group(1).strip(" *_`") for m in YOUR_MOVE.finditer(last_reply(inp))]
    if not moves:
        return ""
    why = bosskit.lint_next(moves[-1])
    if not why:
        return ""
    return (f'The "Your move" line is shorthand ({why}): "{moves[-1]}". Rewrite it as one sentence that stands alone: '
            "what is being decided, the options, your recommendation, and what happens on each answer (template section 9). "
            "Then send your whole reply again with that line, not only the line: the user reads only your last message.")


def mail_reason(cwd):
    """The block reason for unread mail not raised before ("" if none). Kinds and senders only; records the ids it raised."""
    ctx = bosskit.load(cwd, make=False)
    raised_path = os.path.join(ctx.cache, "mail-raised.json")
    try:
        raised = set(json.load(open(raised_path)))
    except (OSError, ValueError, TypeError):
        raised = set()
    new = []
    if os.path.isdir(ctx.inbox):
        for f in sorted(os.listdir(ctx.inbox)):
            try:
                m = json.load(open(os.path.join(ctx.inbox, f)))
            except (OSError, ValueError):
                continue
            if f.endswith(".json") and isinstance(m, dict) and not m.get("read_at") and m.get("id") not in raised:
                new.append(m)
    if not new:
        return ""
    safe = lambda s, n: re.sub(r"[^A-Za-z0-9._-]", "", str(s or ""))[:n] or "?"
    who = ", ".join(f"{safe(m.get('kind'), 12)} from {safe(m.get('from_project'), 40)}" for m in new)
    os.makedirs(ctx.cache, exist_ok=True)
    bosskit.save_json(raised_path, sorted(raised | {m.get("id") for m in new}))
    return f"{len(new)} unread boss mail: {who}; read it with boss-mail inbox and handle it"


def blocks_file(inp):
    sid = re.sub(r"[^\w-]", "", str(inp.get("session_id") or "none"))[:64]
    return os.path.join(tempfile.gettempdir(), f"boss-next-hook-{sid}")


def main():
    try:
        inp = json.load(sys.stdin)
        why = verdict(inp)
        count = blocks_file(inp)
        # consecutive blocks in this session: after MAX_BLOCKS rewrites it lets the reply through, so it can never loop
        n = int(open(count).read() or 0) if inp.get("stop_hook_active") and os.path.exists(count) else 0
        if n >= MAX_BLOCKS:
            why = ""
        if not inp.get("stop_hook_active") and is_boss(inp.get("cwd") or os.getcwd()):
            try:
                mail = mail_reason(inp.get("cwd") or os.getcwd())
            except (SystemExit, Exception):  # no project here, a broken config: no mail check, never a trap
                mail = ""
            why = "\n\n".join(x for x in (why, mail) if x)
        if not why:
            if os.path.exists(count):
                os.remove(count)
            return
        with open(count, "w") as f:
            f.write(str(n + 1))
    except Exception:  # a hook that crashes must never trap the session
        return
    print(json.dumps({"decision": "block", "reason": why}))


if __name__ == "__main__":
    main()
