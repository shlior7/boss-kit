#!/usr/bin/env python3
"""boss-mail: messages between bosses. A message is a JSON file in the target boss's inbox/.

  boss-mail send --to <project|boss-id> --kind question|request|fyi --subject S [--body B | stdin] [--reply-to ID] [--urgent]
  boss-mail inbox                    unread messages, oldest first
  boss-mail read ID                  print one message; stamps read_at in it (the sender's read receipt)
  boss-mail reply ID [--body B | stdin]
  boss-mail done ID                  move it to inbox/done/; stamps done_at
  boss-mail sent [ID]                mail this boss sent (the last 20, or one), each recipient unread / read <time> / done <time>

Addressing a project delivers to every live boss of it (heartbeat in the last 30 min), or to every
registered one when none is live, or, when none ever registered, to every <project>/bosses/*/ directory. With "wake": true in the target boss's
config, one line is also sent to its session so it notices, on the host that boss last ran on: always when that host queues
messages until the agent is idle, else only into an idle agent terminal.

--urgent wakes the target even with "wake": false, at most once per WAKE_GAP_S per target, and prints one line per target:
woke, or skipped (why). The line sent is the kit's fixed one (kind, project, a cleaned subject of at most 80 characters),
never the body. Urgent grants no authority: it only gets the mail read sooner.

Safety: mail is information, never approval. It cannot authorize a merge, push, prod write, spend
or settings change; those need the receiving boss's own user. Never put secrets in mail.
"""
import argparse
import json
import os
import secrets
import subprocess
import sys
import time
import unicodedata
from datetime import datetime

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import bosshost  # noqa: E402
import bosskit  # noqa: E402

KINDS = ("question", "request", "fyi")
WAKE_GAP_S = 300  # one urgent wake per target per 5 min; urgent mail after that waits for the next prompt
STAMP = "%Y-%m-%dT%H:%M:%S%z"
SUBJECT_MAX = 80


def clean(text, cap=SUBJECT_MAX):
    """One line of plain text: control characters and newlines become spaces, at most *cap* characters."""
    t = " ".join("".join(" " if unicodedata.category(c)[0] == "C" else c for c in str(text or "")).split())
    return t if len(t) <= cap else t[:cap - 1] + "…"


def wake_line(msg, urgent=False):
    """The one line a wake sends: built by the kit from the kind, the sender's project and a cleaned subject, never the body."""
    kind = msg["kind"] if msg.get("kind") in KINDS else "message"
    return (f"[boss-mail] {'URGENT ' if urgent else ''}1 new {kind} from {clean(msg.get('from_project'), 40)}: "
            f"{clean(msg.get('subject'))}. Run boss-mail inbox.")


def targets(to, me, reg, home):
    """[(boss id, project)] that `to` addresses."""
    if to in reg:
        return [(to, reg[to]["project"])]
    bosses = {i: b for i, b in reg.items() if b.get("project") == to and i != me}
    alive = bosskit.live(bosses)
    picked = alive or bosses
    if not picked and os.path.basename(to) == to and to not in (".", ".."):
        # A boss that never wrote a heartbeat is not in bosses.json, but its boss dir (and inbox) exists.
        bdir = os.path.join(home, to, "bosses")
        picked = {d: None for d in sorted(os.listdir(bdir)) if os.path.isdir(os.path.join(bdir, d)) and d != me} if os.path.isdir(bdir) else {}
    if not picked:
        sys.exit(f"boss-mail: no boss registered for {to!r} (a boss registers when its pane refreshes)")
    return [(i, to) for i in sorted(picked)]


def wake(h, project, boss, msg, urgent=False):
    """Send one line to the target boss's session when its config opts in (or the mail is urgent), on the host it
    registered with (never this session's host): on a host that queues, always; else into its idle agent terminal only.
    Returns what happened: woke, or skipped (why)."""
    try:
        cfg = bosskit.config_for(h, project, boss)
    except SystemExit:  # a broken config: the mail itself is delivered, the wake is skipped
        return "skipped (bad config)"
    b = bosskit.registry(h).get(boss, {})
    if not (cfg.get("wake") or urgent):
        return "skipped (wake off)"
    if not b.get("workspace"):
        return "skipped (no terminal)"
    stamp = os.path.join(h, project, "bosses", boss, "woken.json")
    if urgent and time.time() - bosshost._json(bosskit._read(stamp), {}).get("at", 0) < WAKE_GAP_S:
        return "skipped (rate-limited)"
    kind = cfg.get("host") or b.get("hostKind")
    if kind not in bosshost.plugins():
        return "skipped (unknown host)"  # which host that boss runs on is unknown here: the inbox file is the delivery
    if b.get("host"):  # the host instance that boss last ran on, unless its config names one
        cfg = bosskit.deep_merge({"hosts": {kind: {"host_id": b["host"]}}}, cfg)
    host = bosshost.get(cfg, kind)
    term = None
    if not host.queues:
        ws = next((w for w in host.workers([b["workspace"]]) if w.get("id") == b["workspace"]), {})
        states = {t["id"]: (t.get("agent") or {}).get("state") for t in ws.get("terminals", []) if t.get("agent")}
        term = next((t for t, st in states.items() if st == "idle"), None)
        if not term:
            return "skipped (" + ("no terminal" if not states else "busy" if "working" in states.values() else "not idle") + ")"
    try:
        host.send(b["workspace"], wake_line(msg, urgent), term)
    except (OSError, subprocess.CalledProcessError):
        return "skipped (send failed)"
    if urgent:
        bosskit.save_json(stamp, {"at": time.time()})
    return "woke"


def send(ctx, to, kind, subject, body, reply_to=None, urgent=False):
    """Deliver to every boss *to* addresses; returns (id, ["project/boss"], {"project/boss": wake result})."""
    if kind not in KINDS:
        sys.exit(f"boss-mail: kind must be one of {', '.join(KINDS)}")
    msg = {"id": time.strftime("%Y%m%d-%H%M%S-") + secrets.token_hex(3), "from_boss": ctx.bid, "from_project": ctx.name,
           "kind": kind, "subject": subject, "body": body, "reply_to": reply_to, "urgent": urgent,
           "created_at": time.strftime(STAMP)}
    sent, woke = [], {}
    for boss, project in targets(to, ctx.bid, bosskit.registry(ctx.home), ctx.home):
        inbox = os.path.join(ctx.home, project, "bosses", boss, "inbox")
        os.makedirs(os.path.join(inbox, "done"), exist_ok=True)
        bosskit.save_json(os.path.join(inbox, msg["id"] + ".json"), msg)
        try:
            woke[f"{project}/{boss}"] = wake(ctx.home, project, boss, msg, urgent)
        except Exception as e:  # the inbox file is the delivery: a failed wake never stops the fan-out
            print(f"boss-mail: waking {project}/{boss} failed: {e}", file=sys.stderr)
            woke[f"{project}/{boss}"] = "skipped (send failed)"
        sent.append(f"{project}/{boss}")
    with open(os.path.join(ctx.bdir, "sent.jsonl"), "a") as f:  # what `sent` reads the receipts back from
        f.write(json.dumps({"id": msg["id"], "to": sent, "kind": kind, "subject": subject, "urgent": urgent,
                            "created_at": msg["created_at"]}) + "\n")
    return msg["id"], sent, woke


def stamp(path, key):
    """Write *key* = now into the message file once (read_at, done_at): the sender's receipt."""
    m = json.load(open(path))
    if not m.get(key):
        m[key] = time.strftime(STAMP)
        bosskit.save_json(path, m)
    return m


def ago(ts, now=None):
    """Minutes since a STAMP time, or None when it does not parse."""
    try:
        return int(((now or time.time()) - datetime.strptime(ts, STAMP).timestamp()) // 60)
    except (TypeError, ValueError):
        return None


def receipts(home, rec):
    """[(project/boss, state)] for one sent record: unread (N min), read <time>, done <time>, or gone."""
    out = []
    for to in rec["to"]:
        project, boss = to.split("/", 1)
        inbox = os.path.join(home, project, "bosses", boss, "inbox")
        m = next((bosshost._json(bosskit._read(p), None) for p in (os.path.join(inbox, rec["id"] + ".json"), os.path.join(inbox, "done", rec["id"] + ".json"))
                  if os.path.exists(p)), None)
        if not m:
            out.append((to, "gone"))
        elif m.get("done_at"):
            out.append((to, f"done {m['done_at']}"))
        elif m.get("read_at"):
            out.append((to, f"read {m['read_at']}"))
        else:
            out.append((to, f"unread ({ago(m.get('created_at'))} min)"))
    return out


def sent_log(ctx, limit=20):
    recs = []
    for line in bosskit._read(os.path.join(ctx.bdir, "sent.jsonl")).splitlines():
        try:
            recs.append(json.loads(line))
        except ValueError:
            continue
    return recs[-limit:]


def find(ctx, mid):
    for d in (ctx.inbox, os.path.join(ctx.inbox, "done")):
        p = os.path.join(d, mid + ".json")
        if os.path.exists(p):
            return p
    sys.exit(f"boss-mail: no message {mid}")


def unread(ctx):
    return [json.load(open(os.path.join(ctx.inbox, f))) for f in sorted(os.listdir(ctx.inbox)) if f.endswith(".json")]


def main():
    ap = argparse.ArgumentParser(prog="boss-mail")
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("send"); s.add_argument("--to", required=True); s.add_argument("--kind", required=True)
    s.add_argument("--subject", required=True); s.add_argument("--body"); s.add_argument("--reply-to")
    s.add_argument("--urgent", action="store_true")
    sub.add_parser("inbox")
    sub.add_parser("sent").add_argument("id", nargs="?")
    for c in ("read", "done"):
        sub.add_parser(c).add_argument("id")
    r = sub.add_parser("reply"); r.add_argument("id"); r.add_argument("--body")
    args = ap.parse_args()
    ctx = bosskit.load()
    body = lambda: args.body if args.body is not None else ("" if sys.stdin.isatty() else sys.stdin.read().strip())

    if args.cmd == "send":
        mid, sent, woke = send(ctx, args.to, args.kind, args.subject, body(), args.reply_to, args.urgent)
        print(f"sent {mid} to {', '.join(sent)}")
        for to in sent if args.urgent else []:
            print(f"  {to}: {woke[to]}")
    elif args.cmd == "inbox":
        msgs = unread(ctx)
        print(f"{len(msgs)} unread" + (":" if msgs else ""))
        for m in msgs:
            age = ago(m.get("created_at"))
            print(f"  {m['id']}  {'URGENT ' if m.get('urgent') else ''}{m['kind']:<8} from {m['from_project']} ({m['from_boss'][:12]}): "
                  f"{m['subject']}" + (f"  (unread {age} min)" if age and age >= 10 else ""))
    elif args.cmd == "sent":
        recs = [r for r in sent_log(ctx, 10 ** 9 if args.id else 20) if not args.id or r["id"] == args.id]
        if args.id and not recs:
            sys.exit(f"boss-mail: no sent message {args.id}")
        print(f"{len(recs)} sent" + (":" if recs else ""))
        for r in recs:
            print(f"  {r['id']}  {'URGENT ' if r.get('urgent') else ''}{r['kind']:<8} {r['subject']}")
            for to, state in receipts(ctx.home, r):
                print(f"      {to}: {state}")
    elif args.cmd == "read":
        m = stamp(find(ctx, args.id), "read_at")
        print(f"{m['kind']} from {m['from_project']} / {m['from_boss']} at {m['created_at']}"
              + (f", in reply to {m['reply_to']}" if m.get("reply_to") else "") + f"\nSubject: {m['subject']}\n\n{m['body']}")
    elif args.cmd == "reply":
        m = stamp(find(ctx, args.id), "read_at")  # replying means it was read
        mid, sent, _ = send(ctx, m["from_boss"], "fyi", "Re: " + m["subject"].removeprefix("Re: "), body(), m["id"])
        print(f"replied {mid} to {', '.join(sent)}")
    else:
        p = find(ctx, args.id)
        stamp(p, "done_at")
        os.replace(p, os.path.join(ctx.inbox, "done", os.path.basename(p)))
        print(f"done {args.id}")


if __name__ == "__main__":
    main()
