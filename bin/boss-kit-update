#!/usr/bin/env python3
"""boss-kit-update: the one command that brings a machine to the latest kit. Run it from any directory; no boss session needed.

  boss-kit-update [--dry-run] [--no-mail]

Steps, in order, each printed:
  1. git pull --ff-only in the kit. A kit with uncommitted changes to tracked files, or one that has diverged from its
     upstream, is refused: it names the files and says how to stash.
  2. claude plugin marketplace update boss-kit, then for each plugin in .claude-plugin/marketplace.json: not installed
     -> claude plugin install; installed with a different version -> claude plugin update; installed with the same version
     but the files under its source dir changed since the commit it was installed from (installed_plugins.json
     gitCommitSha, diffed against the kit) -> claude plugin uninstall then install, because `plugin update` skips a
     plugin whose version did not change and the cache would keep the old copy. A missing claude CLI is a printed skip.
  3. /boss is available: through the "boss" plugin once installed, which also removes the old ~/.claude/skills/boss link
     when that is a symlink into the kit (a real directory, or a link pointing elsewhere, is left alone and named);
     with no claude CLI and no plugin, the link is made.
  4. bin/boss-migrate --apply (an old layout's project data into $BOSS_HOME, host prompt imports); prints what it changed.
  5. One 'fyi' mail to each live boss (written straight to its inbox: the script types into no terminal, so nothing
     lands in a boss's input box). Skipped by --no-mail.
  6. One final block: kit old..new, each plugin old -> new, and the restart line.
--dry-run prints every step and changes nothing (no pull, no plugin command, no write, no mail). It does git fetch (this
moves only origin's refs, not the checkout) and reads the plugin list and the diffs from origin, so it reports what a real
run would do: would install, would update, would reinstall.

The kit is $BOSS_KIT, else $BOSS_KIT_HOME, else the one this script is in.
"""
import json
import os
import secrets
import shutil
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import bosskit  # noqa: E402

LOG_LINES = 10
MARKET = "boss-kit"
RESTART = "Restart each Claude Code session (exit, then `claude --continue`) to load it."


def kit_dir():
    return os.environ.get("BOSS_KIT") or os.environ.get("BOSS_KIT_HOME") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def git(kit, *args):
    return subprocess.run(["git", "-C", kit, *args], capture_output=True, text=True)


def claude_home():
    return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")


def installed():
    """{plugin@marketplace: {"version", "sha"}} from Claude Code's installed_plugins.json ({} when unreadable)."""
    try:
        d = json.load(open(os.path.join(claude_home(), "plugins", "installed_plugins.json")))
        return {k: {"version": (v[0].get("version") or "?"), "sha": v[0].get("gitCommitSha")} if v else {"version": "?", "sha": None}
                for k, v in d.get("plugins", {}).items()}
    except (OSError, ValueError, AttributeError):
        return {}


def version(info, key):
    return (info.get(key) or {}).get("version")


def marketplace(kit, ref="HEAD"):
    """{plugin name: {"version", "source"}} the kit's marketplace lists at ref (origin's, for a dry run)."""
    try:
        r = git(kit, "show", f"{ref}:.claude-plugin/marketplace.json")
        return {p["name"]: {"version": p.get("version", "?"), "source": os.path.normpath(p.get("source", "./"))}
                for p in json.loads(r.stdout).get("plugins", [])}
    except (ValueError, KeyError):
        return {}


def pull(kit, dry=False):
    """Fast-forward the kit; (old, new, ref, note): short shas, the ref the plugin list is read from, a note for the output.
    Exits on a dirty or diverged kit. A dry run only fetches: new is what origin has, ref is origin's."""
    if not os.path.exists(os.path.join(kit, ".git")):
        sys.exit(f"boss-kit-update: {kit} is not a git checkout")
    dirty = git(kit, "status", "--porcelain", "--untracked-files=no").stdout.rstrip()
    if dirty.strip():
        sys.exit(f"boss-kit-update: {kit} has uncommitted changes:\n{dirty}\n"
                 f"Stash them (git -C {kit} stash push -m before-update, then git -C {kit} stash pop after), or discard them, and run it again.")
    old = git(kit, "rev-parse", "--short", "HEAD").stdout.strip()
    if dry:
        f, up = git(kit, "fetch", "--quiet"), git(kit, "rev-parse", "--verify", "--short", "@{u}")
        if f.returncode or up.returncode:
            return old, old, "HEAD", "could not fetch origin (" + (f.stderr or "no upstream").strip().splitlines()[-1] + "): reporting from the local kit"
        return old, up.stdout.strip(), "@{u}", ""
    r = git(kit, "pull", "--ff-only", "--quiet")
    if r.returncode:
        sys.exit(f"boss-kit-update: {kit} cannot fast-forward (diverged from its upstream, or no upstream): {r.stderr.strip()}\n"
                 f"Rebase or reset it to its upstream yourself (git -C {kit} status), then run this again.")
    return old, git(kit, "rev-parse", "--short", "HEAD").stdout.strip(), "HEAD", ""


def claude(*args):
    """Run the claude CLI: (ok, last output line)."""
    r = subprocess.run(["claude", *args], capture_output=True, text=True)
    tail = (r.stdout + r.stderr).strip().splitlines()
    return r.returncode == 0, tail[-1] if tail else ""


def changed(kit, sha, ref, paths):
    """True when the plugin's files differ between the commit it was installed from and ref (or that commit is unknown here)."""
    return git(kit, "diff", "--quiet", sha, ref, "--", *paths).returncode != 0


def own_files(p, plugins):
    """Pathspec of a plugin's own files: its source dir, minus the source dirs of other plugins nested in it (the boss plugin's
    source is the kit root, which holds mods/boss-deck)."""
    nested = lambda q: q is not p and (p["source"] == "." or q["source"].startswith(p["source"] + os.sep))
    return [p["source"]] + [f":(exclude){q['source']}" for q in plugins.values() if nested(q)]


def update_plugins(kit, ref, dry, before):
    """Step 2: refresh the marketplace; install each plugin it lists that is not installed, update one whose version moved,
    reinstall one whose files changed under the same version. Returns (lines, failed)."""
    plugins = marketplace(kit, ref)
    if not shutil.which("claude"):
        return ["skip: the claude CLI is not on PATH. In Claude Code run /plugin marketplace update "
                f"{MARKET}, then /plugin update (or /plugin install) <plugin>@{MARKET} for each of: {', '.join(plugins) or 'the kit plugins'}"], False
    steps = [("run", [["plugin", "marketplace", "update", MARKET]], "")]
    for n, p in plugins.items():
        key, have = f"{n}@{MARKET}", before.get(f"{n}@{MARKET}")
        if not have:
            steps.append(("install", [["plugin", "install", key]], ""))
        elif have["version"] == p["version"] and have["sha"] and changed(kit, have["sha"], ref, own_files(p, plugins)):
            steps.append(("reinstall", [["plugin", "uninstall", key], ["plugin", "install", key]], "files changed, version unchanged"))
        else:
            steps.append(("update", [["plugin", "update", key]], ""))
    lines, failed = [], False
    for kind, argvs, why in steps:
        if dry:
            lines.append(f"would {kind}{f' ({why})' if why else ''}: " + ", then ".join("claude " + " ".join(a) for a in argvs))
            continue
        for argv in argvs:
            ok, last = claude(*argv)
            failed |= not ok
            lines.append(f"{'ok  ' if ok else 'FAIL'} claude {' '.join(argv)}" + (f": {last[:120]}" if last else "")
                         + (f" ({kind}ed: {why})" if ok and why and argv is argvs[-1] else ""))
            if not ok:
                break
    return lines, failed


def ensure_boss_skill(kit, dry, planned=()):
    """Step 3: say how /boss is provided. Once the boss plugin is there, the old link into the kit goes (a real directory, or
    a link pointing elsewhere, is left alone and named). Without the plugin and without claude, link it. (lines, failed)"""
    link = os.path.join(claude_home(), "skills", "boss")
    here = f"boss@{MARKET}" in installed()
    plugin = here or "boss" in planned
    if not os.path.lexists(link):
        if plugin:
            return [f"/boss {'comes' if here else 'will come'} from the boss plugin"], False
        if shutil.which("claude"):
            return ["/boss is not available: the boss plugin did not install (see step 2)"], True
        if dry:
            return [f"would link {link} to {kit}/skills/boss (no claude CLI to install the plugin)"], False
        os.makedirs(os.path.dirname(link), exist_ok=True)
        os.symlink(os.path.join(kit, "skills", "boss"), link)
        return [f"linked {link} so /boss is available (no claude CLI to install the plugin)"], False
    if not plugin:
        return [f"/boss comes from the link {link} (the boss plugin, `claude plugin install boss@{MARKET}`, replaces it)"], False
    real, root = os.path.realpath(link), os.path.realpath(kit)
    if os.path.islink(link) and os.path.commonpath([real, root]) == root:
        if dry:
            return [f"would remove the old link {link} -> {os.readlink(link)}: /boss comes from the boss plugin"], False
        target = os.readlink(link)
        os.remove(link)
        return [f"removed the old link {link} -> {target}: /boss comes from the boss plugin"], False
    return [f"left {link} alone ({'a link pointing outside the kit' if os.path.islink(link) else 'a real directory'}): "
            "/boss will show twice; remove it yourself"], False


def migrate(kit, dry):
    """Step 4: boss-migrate for the registered bosses; its own output, trimmed."""
    argv = [sys.executable, os.path.join(os.path.dirname(os.path.abspath(__file__)), "boss-migrate"), "--kit", kit] + ([] if dry else ["--apply"])
    r = subprocess.run(argv, capture_output=True, text=True)
    out = (r.stdout + r.stderr).strip().splitlines()
    return ([f"{'would run' if dry else 'ran'} boss-migrate{'' if dry else ' --apply'}"] + [f"  {l}" for l in out[:8]]
            + ([f"  … {len(out) - 8} more lines"] if len(out) > 8 else [])), r.returncode != 0


def notify(h, subject, log, now=None):
    """Mail every live boss in the registry; the boss ids mailed. Writes inbox files only."""
    now = now or time.time()
    msg = {"id": time.strftime("%Y%m%d-%H%M%S-", time.localtime(now)) + secrets.token_hex(3), "from_boss": "boss-kit-update",
           "from_project": "kit", "kind": "fyi", "subject": subject,
           "body": log, "reply_to": None, "created_at": time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(now))}
    sent = []
    for boss, b in sorted(bosskit.live(bosskit.registry(h), now).items()):
        if not b.get("project"):
            continue
        inbox = os.path.join(h, b["project"], "bosses", boss, "inbox")
        os.makedirs(os.path.join(inbox, "done"), exist_ok=True)
        bosskit.save_json(os.path.join(inbox, msg["id"] + ".json"), msg)
        sent.append(boss)
    return sent


def main(argv):
    if set(argv) - {"--dry-run", "--no-mail"}:
        sys.exit(__doc__)
    dry, no_mail = "--dry-run" in argv, "--no-mail" in argv
    kit = kit_dir()
    failed = False

    def step(n, title, lines=()):
        print(f"[{n}/5] {title}")
        for l in lines:
            print("  " + l)

    print(f"boss-kit-update{' (dry run: nothing changes)' if dry else ''}: kit {kit}")
    old, new, ref, note = pull(kit, dry)
    log = git(kit, "log", "--oneline", f"-{LOG_LINES}", f"{old}..{new}").stdout.strip() if old != new else ""
    head = (f"would git pull --ff-only: {old}..{new}" if old != new else f"would git pull --ff-only (already at {new})") if dry \
        else f"updated {old}..{new}" if old != new else f"already at {new}"
    step(1, "kit", [head] + ([note] if note else []) + [f"  {l}" for l in log.splitlines()])
    before = installed()
    lines, bad = update_plugins(kit, ref, dry, before)
    failed |= bad
    step(2, "plugins", lines)
    planned = {n for n in marketplace(kit, ref) if f"{n}@{MARKET}" not in before} if dry and shutil.which("claude") else ()
    lines, bad = ensure_boss_skill(kit, dry, planned)
    failed |= bad
    step(3, "/boss", lines)
    lines, bad = migrate(kit, dry)
    failed |= bad
    step(4, "migrate", lines)
    after = installed()
    mk = lambda k: k.endswith("@" + MARKET)
    moved = {k: (version(before, k), v["version"]) for k, v in after.items()
             if mk(k) and (version(before, k), (before.get(k) or {}).get("sha")) != (v["version"], v["sha"])}
    was_changed = old != new or bool(moved)
    ver = lambda n: version(after, f"{n}@{MARKET}") or marketplace(kit, ref).get(n, {}).get("version", "?")
    sent = []
    if dry or no_mail:
        mail = "would mail the live bosses" if dry else "skipped (--no-mail)"
    elif not was_changed:
        mail = "nothing changed: nobody mailed"
    else:
        sent = notify(bosskit.home(), f"kit updated {old}..{new}: restart the session (claude --continue) to load boss-deck {ver('boss-deck')}", log)
        mail = f"mailed {len(sent)} live boss{'' if len(sent) == 1 else 'es'}" + (": " + ", ".join(sent) if sent else "")
    step(5, "mail", [mail])
    mine = {k.split("@")[0]: v["version"] for k, v in after.items() if mk(k)}
    if moved:
        plugins = "; ".join(f"{k.split('@')[0]} {a or 'new'} -> {b}" if a != b else f"{k.split('@')[0]} {b} (reinstalled, files changed)"
                            for k, (a, b) in sorted(moved.items()))
    else:
        plugins = (", ".join(f"{k} {v}" for k, v in sorted(mine.items())) + " (unchanged)") if mine else "none installed from this marketplace"
    print("\n" + "\n".join([
        f"Kit:     {old}..{new}" if old != new else f"Kit:     {new} (up to date)",
        f"Plugins: {plugins}",
        "Dry run: nothing was changed." if dry else RESTART if was_changed else "Up to date: nothing to restart.",
    ]))
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main(sys.argv[1:])
